{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IngestQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:SendMessageBatch",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:DeleteMessageBatch",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:<ACCOUNT_ID>:splunk-ingest",
        "arn:aws:sqs:us-east-1:<ACCOUNT_ID>:splunk-ingest-dlq"
      ]
    },
    {
      "Sid": "LargeMessageOverflowBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::my-splunk-ingest-overflow/*"
    },
    {
      "Sid": "LargeMessageOverflowBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::my-splunk-ingest-overflow"
    }
  ]
}
